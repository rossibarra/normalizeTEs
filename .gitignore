# Conda and Python
.conda/
.venv/
__pycache__/
*.py[cod]
*.bak

# Scientific Python caches
.matplotlib/
.pytest_cache/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
.claude/settings.local.json

# Posterior ARG draws and interval stores (GB-scale, live on Quobyte)
*.tsz
results/interval-gate3-3draw-store/
results/ancestral-75draw/*.npy
results/ancestral-smoke-1draw/
results/work-*/

# Large result arrays: row indices, CDFs, per-site ancestral counts.
# JSON provenance and metadata beside them are kept.
results/**/*.npy
results/*.npy

# SLURM logs
results/*.out
results/*.err

# Position lists are inputs staged from the upstream analysis directory
*.pos.txt

# Generated source snapshots and doc backups
results/snapshot-*/
*.bak2

# SLURM writes scheduler logs to the submission directory, which is the repo
# root: the files are opened before the job script runs, so they cannot be
# placed under results/ by the launcher itself.
bootstrap-match-*.out
bootstrap-match-*.err
polarity-mask-*.out
polarity-mask-*.err
phi-sfs-*.out
phi-sfs-*.err
ancestral-*.out
ancestral-*.err
